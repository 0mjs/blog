package views

import (
	"fmt"
	"mattjs.me/internal/model"
	"strconv"
)

templ BlogList(posts []*model.Post) {
	@Layout(SEO{Title: "All writing", Description: "Writing by " + siteName + ".", Path: "/blog"}) {
		<main class="frame" id="content">
			@pageHeading("writing", "Writing", formatPostCount(len(posts)))
			@postList(posts)
		</main>
	}
}

templ BlogListByTag(posts []*model.Post, tag string) {
	@Layout(SEO{Title: "Posts tagged: " + tag, Description: "Blog posts tagged with " + tag, Path: "/blog/tag/" + tag}) {
		<main class="frame" id="content">
			@pageHeading("tag", "#"+tag, formatPostCount(len(posts)))
			@postList(posts)
		</main>
	}
}

// The heading block shared by the archive and tag pages, with the blinking cursor after the title.
templ pageHeading(label, title, count string) {
	<header class="block page-heading">
		<div class="grid-bg" aria-hidden="true"></div>
		<p class="eyebrow reveal">{ label }</p>
		<h1 class="reveal" style="--d: 80ms"><span class="headline-fade">{ title }</span><span class="blink" aria-hidden="true">_</span></h1>
		<p class="count reveal" style="--d: 160ms">{ count }</p>
	</header>
}

templ postList(posts []*model.Post) {
	<section class="block" data-reveal>
		if len(posts) == 0 {
			<p class="empty">Nothing here yet.</p>
		} else {
			<div class="rows">
				for i, post := range posts {
					<article class="archive-row" style={ rowIndex(i) }>
						<a class="row" href={ templ.SafeURL("/blog/" + post.Slug) }>
							<span class="row-offset" aria-hidden="true">{ hexOffset(i) }</span>
							<div class="row-copy">
								<h2 class="row-title" style={ postTransition(post.Slug) }>{ post.Title }</h2>
								<p class="row-description">{ post.Subtitle }</p>
							</div>
							<time class="row-date" datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format("Jan 2006") }</time>
						</a>
						<div class="tags">
							<span>{ formatReadTime(post.ReadTime) }</span>
							for _, tag := range post.Tags {
								<a href={ templ.SafeURL("/blog/tag/" + tag) }>#{ tag }</a>
							}
						</div>
					</article>
				}
			</div>
		}
	</section>
}

templ BlogPost(post *model.Post) {
	@Layout(SEO{Title: post.Title, Description: post.Subtitle, Path: "/blog/" + post.Slug, Article: true, Published: post.Date}) {
		<main class="frame" id="content">
			<article>
				<header class="block article-heading">
					<div class="grid-bg" aria-hidden="true"></div>
					<p class="eyebrow reveal">
						<time datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format("Jan 2, 2006") }</time> · { formatReadTime(post.ReadTime) }
					</p>
					<h1 class="reveal" style={ titleStyle(post.Slug) }><span class="headline-fade">{ post.Title }</span></h1>
					<p class="article-subtitle reveal" style="--d: 160ms">{ post.Subtitle }</p>
					<div class="tags reveal" style="--d: 220ms">
						for _, tag := range post.Tags {
							<a href={ templ.SafeURL("/blog/tag/" + tag) }>#{ tag }</a>
						}
					</div>
				</header>
				<div class="block prose">@templ.Raw(post.HTML)
</div>
				<footer class="block article-footer">
					<a href="/blog">← All writing</a>
					<a href="#content">Back to top ↑</a>
				</footer>
			</article>
		</main>
	}
}

// NotFound is served for any address that isn't a page, with a 404 status.
templ NotFound() {
	@Layout(SEO{Title: "Page not found", Description: "This page doesn't exist.", Path: "/404", NoIndex: true}) {
		<main class="frame" id="content">
			<section class="block missing">
				<div class="grid-bg" aria-hidden="true"></div>
				<p class="eyebrow reveal">404</p>
				<h1 class="headline reveal" style="--d: 80ms"><span class="headline-fade">Nothing here.</span></h1>
				<p class="reveal" style="--d: 160ms">This page doesn't exist, or it moved. Try the homepage or the writing.</p>
				<nav class="social reveal" style="--d: 240ms" aria-label="Elsewhere">
					<a class="pill" href="/">
						Home
						@arrow(false)
					</a>
					<a class="pill" href="/blog">
						All writing
						@arrow(false)
					</a>
				</nav>
			</section>
		</main>
	}
}

// hexOffset labels list rows like lines in a hex editor: 0x00, 0x10, 0x20…
func hexOffset(i int) string { return fmt.Sprintf("0x%02X", i*16) }
// postTransition names a post's title so it morphs between list and article pages.
func postTransition(slug string) templ.SafeCSS {
	return templ.SafeCSS("view-transition-name: post-" + slug)
}
// titleStyle combines the title's view-transition name with its reveal delay.
func titleStyle(slug string) templ.SafeCSS {
	return templ.SafeCSS("view-transition-name: post-" + slug + "; --d: 80ms")
}
func formatReadTime(minutes int) string { return strconv.Itoa(minutes) + " min read" }
func formatPostCount(count int) string {
	if count == 1 {
		return "1 entry"
	}
	return strconv.Itoa(count) + " entries"
}
