package views

import "mattjs.me/internal/model"

templ Home(posts []*model.Post, projects []model.Project) {
	@Layout(SEO{Path: "/"}) {
		<main class="shell home-shell" id="content">
			<header>
				<div class="profile">
					<span class="avatar" data-file="matt.png · 256 bytes">
						<img class="profile-avatar" src={ avatarURL } alt={ siteName } width="104" height="104" fetchpriority="high" decoding="async"/>
					</span>
					<div class="profile-copy">
						<h1>{ siteName }</h1>
						<p class="tagline">{ siteTagline }<span class="cursor" aria-hidden="true"></span></p>
					</div>
				</div>
				@socialLinks()
			</header>
			<section class="section projects-section" aria-labelledby="projects-title">
				<div class="section-head"><h2 id="projects-title">Projects</h2></div>
				<ul class="rows project-rows">
					for i, project := range projects {
						<li>
							<a class="row" href={ templ.SafeURL(project.URL) } target="_blank" rel="noopener">
								<span class="row-offset" aria-hidden="true">{ hexOffset(i) }</span>
								<span class="row-copy">
									<span class="row-title">
										{ project.Name }
										if project.State != "" {
											<span class="status" data-state={ project.State }>{ project.State }<span class="status-stage">{ project.Stage }</span></span>
										}
									</span>
									<span class="row-description">{ project.Description }</span>
								</span>
								if project.Kind != "" {
									<abbr class="row-kind" title={ kindTitle(project.Kind) }>{ project.Kind }</abbr>
								}
								@arrow(true)
							</a>
						</li>
					}
				</ul>
			</section>
			if len(posts) > 0 {
				<section class="section writing-section" aria-labelledby="writing-title">
					<div class="section-head"><h2 id="writing-title">Writing</h2><a href="/blog">All writing</a></div>
					<ul class="rows writing-rows">
						for i, post := range posts {
							<li>
								<a class="row" href={ templ.SafeURL("/blog/" + post.Slug) }>
									<span class="row-offset" aria-hidden="true">{ hexOffset(i) }</span>
									<span class="row-copy"><span class="row-title" style={ postTransition(post.Slug) }>{ post.Title }</span></span>
									<time class="row-date" datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format("Jan 2006") }</time>
									@arrow(false)
								</a>
							</li>
						}
					</ul>
				</section>
			}
			@footer()
		</main>
		<script src={ avatarScriptURL } defer></script>
		<script src={ bytesScriptURL } defer></script>
	}
}
