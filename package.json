{
  "name": "mattjs-blog",
  "private": true,
  "scripts": {
    "favicon": "sh scripts/generate-favicons.sh",
    "css": "tailwindcss -i ./assets/css/input.css -o ./public/app.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/input.css -o ./public/app.css --watch",
    "build:static": "npm run css && go run ./cmd/export",
    "preview:worker": "npm run build:static && wrangler dev",
    "deploy": "npm run build:static && wrangler deploy",
    "deploy:dry-run": "npm run build:static && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "4.131.0"
  }
}
